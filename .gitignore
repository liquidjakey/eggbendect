# ============================================================================
# 개발환경 공통 .gitignore — 기본 devenv(root) · Jupyter · code-server 호환
#   개발환경은 $HOME(=단일 PVC) 위에서 동작하며 repo 를 clone/commit 하므로,
#   파드 런타임/홈 dotfile/IDE 캐시/자격증명이 repo 에 섞이지 않게 차단한다.
# ============================================================================

models
model

# --- SSH / sshd 런타임 (rootless sshd: host key·pid·log·sshd_config) ---
.ssh
.ssh/
.sshd/

# --- 홈 dotfile / XDG 설정 (code-server ~/.config/code-server 등) ---
.config/
.cache
.cache/
.local/
.npm/
.conda/
.condarc
.jupyter/
.ipython/
.virtual_documents/
.bash_logout
.bashrc
.profile
.wget-hsts

# --- 셸 / 도구 히스토리·런타임 흔적 ---
.bash_history
.python_history
.viminfo
.lesshst
.sudo_as_admin_successful
.motd_shown

# --- VS Code / code-server 서버·확장 ---
.vscode/
.vscode-server
.vscode-server-insiders/
vscode_cli_alpine_x64_cli.tar.gz
vscode-server-linux-x64.tar.gz

# --- 기타 에디터 (JetBrains·vim swap 등) ---
.idea/
*.swp
*.swo
*~

# --- 자격증명/시크릿 (절대 커밋 금지) ---
.gitconfig
.git-credentials
.netrc
.gnupg/
.pki/
.docker/
.aws/
.azure/
.kube/

# --- Python 캐시 / 빌드 / 가상환경 ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints
venv
venv/
.venv/

# --- Node (code-server JS 프로젝트) ---
node_modules/
.yarn/
npm-debug.log*
yarn-error.log*

# --- mlflow / 실험 산출물 ---
mlruns/

# --- 데이터 / 모델 산출물 ---
# 앞에 / 를 붙여 저장소 루트 기준으로 고정한다 (안 붙이면 어느 위치든 그
# 이름의 폴더를 뜻해서, src/core/frontend/src/data/ 같은 코드 폴더까지 막힘).
/data
/data/
model/
models/
checkpoints/
*.h5
*.pt
*.pkl
*.pb

# --- 비밀/로그/임시 ---
*.env
.env.*
*.log
nohup.out
/tmp/*
/var/tmp/*
/cache/*

# --- OS ---
*.DS_Store
Thumbs.db
Desktop.ini

# --- 계란 판 검출 학습 (AI Hub 데이터 재배포 금지) ---
# 앞에 / 를 붙여 저장소 루트 기준으로 고정한다.
# 안 붙이면 "어느 위치든 그 이름의 폴더"를 뜻해서 work/color/ 같은 코드 폴더까지 막힌다.
/color/
/mono/
/runs/
/logs/
/datasets/
/data/
*.pt

# AI Hub 계란 데이터는 재배포 금지 — jpg 는 어느 경로에 있든 커밋을 막는다.
# (png 는 막지 않는다: 프론트엔드 자산과 ultralytics 학습 그래프가 png 이고,
#  AI Hub 원본에는 png 가 한 장도 없어 재배포 위험이 없다.)
*.jpg
*.jpeg

# --- Claude Code (에이전트 설정·대화기록·메모리) ---
.claude/
.claude.json
.claude.json.tmp.*
CLAUDE.md
.mcp.json
.nv/

# --- 잘못된 리다이렉트로 생긴 흔적 파일 ---
=*

# 백엔드 인계용 COLOR 모델 3종만 예외로 허용한다 (2026-08-26).
#   color_yolo11n.pt   5.2MB   속도 우선 후보
#   color_yolo11m.pt  38.6MB   성능·속도 균형. 실배포 유력
#   color_rtdetr-l.pt 63.2MB   비교 기록용
#
# ★ git 에 들어간 바이너리는 지워도 이력에 영구히 남는다. 실제로 rail.png(1.8MB)가
#   ed9b695 에서 삭제됐지만 저장소 이력에 그대로 남아 있다. 그러므로:
#   - 모델을 갱신할 때 새 파일을 추가하지 말고 같은 파일을 덮어써라 (이력은 늘지만 관리는 단순)
#   - 실험용 중간 가중치는 절대 올리지 마라. 최종 인계본만 올린다
#   - yolo11x 등 새 모델을 추가할 땐 정말 백엔드가 써야 하는지 먼저 확인해라
!work/color_result/color_yolo11n.pt
!work/color_result/color_yolo11m.pt
!work/color_result/color_rtdetr-l.pt

# --- backend (FastAPI) 런타임 산출물 ---
src/core/backend/app.db
src/core/backend/storage/*
!src/core/backend/storage/.gitkeep

# 평가 산출물 (생성물이므로 저장소에 넣지 않는다)
/results/

# 개인 작업 노트 (저장소에 올리지 않는다)
/notes/

# 부하테스트용 대용량 샘플 이미지 (수천 개, 커밋 대상 아님)
photos/
